# ══════════════════════════════════════════════════════════════
#  BonviZvonki — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ─── Umumiy ───────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# Ishlab chiqarishda ALBATTA o'zgartiring:
#   openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me-in-production-please-0123456789

# ─── Portlar (host tomonda) ───────────────────────────────────
API_PORT=8010
WEB_PORT=5180
POSTGRES_PORT=5433
REDIS_PORT=6380

# ─── Ma'lumotlar bazasi ───────────────────────────────────────
POSTGRES_USER=zvonki
POSTGRES_PASSWORD=zvonki_dev_password
POSTGRES_DB=zvonki

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8010

# Panelning TASHQI manzili — Telegram xabaridagi «Panelda ochish»
# havolasi uchun. Backend o'z manzilini bilmaydi, shuning uchun uni
# shu yerda ko'rsatish kerak.
# Bo'sh qoldirilsa havola xabarga QO'SHILMAYDI — ishlamaydigan
# `localhost` havolasi rahbar telefonida xatolik sahifasini ochardi.
PUBLIC_WEB_URL=

# ─── Auth ─────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Ichki xizmatlar tokeni (bot ↔ backend) ───────────────────
# Bot'ning foydalanuvchi hisobi yo'q, shuning uchun JWT o'rniga
# umumiy maxfiy kalit ishlatiladi (`X-Internal-Token` sarlavhasi).
# Bo'sh qolsa — ichki endpointlar butunlay yopiladi (401).
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# ─── Boshlang'ich admin (seed) ────────────────────────────────
FIRST_ADMIN_EMAIL=admin@zvonki.uz
FIRST_ADMIN_PASSWORD=admin12345
# Demo ma'lumotlar (agentlar, qo'ng'iroqlar, ballar) yaratilsinmi?
SEED_DEMO_DATA=true

# ══════════════════════════════════════════════════════════════
#  AI PROVAYDERLARI
#  ⚠️  Bularni .env da ham, keyinchalik dashboard →
#      "Sozlamalar" bo'limida ham o'zgartirish mumkin.
#      Bazadagi qiymat .env dan ustun turadi.
# ══════════════════════════════════════════════════════════════

# ─── Sun'iy intellekt ─────────────────────────────────────────
#
# ⚠️ BU YERDA AI SOZLAMASI YO'Q — bu ATAYLAB.
#
# Provayder, model va API kalitlar FAQAT admin panelda turadi:
#   Sozlamalar → Sun'iy intellekt
#
# Ilgari ular shu yerda ham bor edi va chalkashlik tug'dirardi:
# ekranda «Gemini» ko'rinib turar, tizim esa `.env` dagi boshqa
# provayderda ishlayverar va buni hech kim sezmasdi. Endi ekranda
# nima tanlangan bo'lsa — quvur aynan shuni ishlatadi.
#
# Audio va tahlil ALOHIDA tanlanadi: masalan audio Gemini'da,
# baholash Claude'da bo'lishi mumkin.

# ─── Telegram bot ─────────────────────────────────────────────
# @BotFather dan oling.
# Bu yerdagi qiymat faqat ZAXIRA: bot avval backend'dan
# (baza → Sozlamalar sahifasi) so'raydi, javob bo'lmasa shunga qaytadi.
TELEGRAM_BOT_TOKEN=
# Bot o'zi `get_me()` orqali aniqlaydi va backend'ga yozib qo'yadi.
TELEGRAM_BOT_USERNAME=

# ─── MoyZvonki ────────────────────────────────────────────────
MOIZVONKI_DOMAIN=
MOIZVONKI_USER=
MOIZVONKI_API_KEY=

# ─── SMS (Eskiz.uz) — zaxira kanal ────────────────────────────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ─── Object storage (audio arxiv) ─────────────────────────────
# Variantlar: minio | s3 | r2
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=zvonki-audio
